# Ship Design local environment template

# AI generation stays local/mock unless this is set to real and OPENAI_API_KEY is present.
AI_GENERATION_MODE=mock
OPENAI_API_KEY=
AI_DEFAULT_MODEL=gpt-4.1-mini
AI_FAST_MODEL=gpt-4.1-mini
AI_REASONING_MODEL=gpt-4.1

# Cost and reliability guardrails for future real AI generation.
MAX_RUN_COST_USD=2.00
MAX_AGENT_RETRIES=1
MAX_OUTPUT_TOKENS_PER_AGENT=2500
AI_REQUEST_TIMEOUT_MS=60000

# App/database placeholders for later phases.
NEXT_PUBLIC_APP_URL=http://localhost:3002
DATABASE_URL=

# Figma placeholders for later phases.
FIGMA_ACCESS_TOKEN=
FIGMA_TEAM_ID=
FIGMA_FILE_TEMPLATE_ID=
