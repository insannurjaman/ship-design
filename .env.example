# Ship Design local environment template

# AI generation stays local/mock unless this is set to real and a real provider key is present.
AI_GENERATION_MODE=mock

# Free-first provider gateway priority:
# mock -> gemini -> groq -> openrouter -> huggingface
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Cost and reliability guardrails for future real AI generation.
MAX_RUN_COST_USD=2.00
MAX_AGENT_RETRIES=1
MAX_OUTPUT_TOKENS_PER_AGENT=2500
AI_REQUEST_TIMEOUT_MS=60000

# App/database placeholders for later phases.
NEXT_PUBLIC_APP_URL=http://localhost:3002
DATABASE_URL=

# Figma placeholders for later phases.
FIGMA_ACCESS_TOKEN=
FIGMA_TEAM_ID=
FIGMA_FILE_TEMPLATE_ID=
