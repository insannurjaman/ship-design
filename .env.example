# Ship Design local environment template

# AI generation stays local/mock unless this is set to real and a real provider key is present.
AI_GENERATION_MODE=mock
AI_PROVIDER=gemini

# Free-first provider gateway priority:
# mock -> gemini -> groq -> openrouter -> huggingface
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_DEFAULT_MODEL=qwen/qwen3-32b
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_FAST_MODEL=openrouter/free
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_REASONING_MODEL=openrouter/free
HF_TOKEN=
HF_DEFAULT_MODEL=

# Cost and reliability guardrails for future real AI generation.
MAX_RUN_COST_USD=0.00
MAX_AGENT_RETRIES=1
MAX_OUTPUT_TOKENS_PER_AGENT=1800
AI_REQUEST_TIMEOUT_MS=45000
MAX_REAL_AGENT_TASKS_PER_RUN=3

# App/database placeholders for later phases.
NEXT_PUBLIC_APP_URL=http://localhost:3002
DATABASE_URL=

# Figma placeholders for later phases.
FIGMA_ACCESS_TOKEN=
FIGMA_TEAM_ID=
FIGMA_FILE_TEMPLATE_ID=
